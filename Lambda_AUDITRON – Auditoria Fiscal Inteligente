    estados = ['SP', 'RJ', 'MG', 'RS', 'PR', 'SC', 'BA', 'GO']
    dados = []
    for i in range(num_registros):
        valor_base = random.uniform(500, 50000)
        dados.append({
            'numero_nota': f"NF{str(i+1).zfill(6)}",
            'cnpj_emissor': f"{random.randint(10000000, 99999999):08d}0001{random.randint(10, 99)}",
            'cfop': random.choice(cfops),
            'valor_total_nota': round(valor_base, 2),
