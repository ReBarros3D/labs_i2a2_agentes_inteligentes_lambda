# --- Funções do backend ---
def formatar_moeda(valor: float) -> str:
    """Formata valor para moeda brasileira"""
    if not isinstance(valor, (int, float)):
        return str(valor)
    return f"R$ {valor:,.2f}".replace(",", "X").replace(".", ",").replace("X", ".")

def normalizar_nome_coluna(nome):
    return nome.lower().strip().replace(" ", "_").replace("-", "_")

def encontrar_coluna_similar(nome_buscado, colunas_df):
    nome_normalizado = normalizar_nome_coluna(nome_buscado)
    for col in colunas_df:
        if normalizar_nome_coluna(col) == nome_normalizado:
            return col
    for col in colunas_df:
        col_norm = normalizar_nome_coluna(col)
        if nome_normalizado in col_norm or col_norm in nome_normalizado:
            return col
    return None

def criar_dados_exemplo():
